<form class="mt-4" method="POST" action="/courses/handle-form-actions">
    <div>
        <h3>Khóa Học Đã Xóa Của Tôi</h3>
        <a href="/me/stored/courses">Danh Sách Khóa Học</a>

        <div class="mt-4 d-flex align-items-center">
            <div class="form-check">
                <input class="form-check-input" type="checkbox" value="" id="checkbox-all">
                <label class="form-check-label" for="checkbox-all">
                    Chọn tất cả
                </label>
            </div>

            <select class="form-control form-control-sm checkbox-sellect-all-options" name="action" required>
                <option value="">--- Chọn Hành Động ---</option>
                <option value="restore">Khôi Phục</option>
                <option value="force-delete">Xóa Cứng</option>
            </select>

            <button class="btn btn-primary btn-sm btn-check-all-submit-btn" disabled>
                Thực hiện
            </button>
        </div>
    </div>

    <table class="table mt-4">
        <thead>
            <tr>
                <th scope="col"></th>
                <th scope="col">#</th>
                <th scope="col">Tên Khóa Học</th>
                <th scope="col">Ảnh Khóa Học</th>
                <th scope="col">Thời Gian Xóa</th>
                <th scope="col">Hành Động</th>
            </tr>
        </thead>
        <tbody>
            {{#each courses}}
            <tr>
                <td>
                    <div class="form-check">
                        <input class="form-check-input" type="checkbox" name="courseIds" value="{{ this._id }}">
                    </div>
                </td>
                {{! Custom buildin helper express-handlebar }}
                <td scope="row">{{sum @index 1}}</td>
                <td>{{this.name}}</td>
                <td>
                    <img class="avatar-image" src="{{this.thumbnail}}" alt="" />
                </td>
                <td>{{this.deletedAt}}</td>
                <td>
                    <a href="#" class="btn btn-link btn-restore" data-id={{this._id}}>Khôi phục</a>
                    <a href="#" data-toggle="modal" data-target="#deleteModal" data-id="{{this._id}}"
                        class="btn btn-link">
                        Xóa vĩnh viễn
                    </a>
                </td>
            </tr>
            {{else}}
            <tr>
                <td colspan="5" class="text-center">
                    Thùng rác đang trống !
                    <a href="/me/stored/courses">Khóa học của tôi</a>
                </td>
            </tr>
            {{/each}}
        </tbody>
    </table>
</form>

{{! Confirm delete courses - Bootstrap 4 }}
<div class="modal" id="deleteModal" tabindex="-1" role="dialog">
    <div class="modal-dialog" role="document">
        <div class="modal-content">
            <div class="modal-header">
                <h5 class="modal-title">Xóa Vĩnh Viễn Khóa Học ?</h5>
                <button type="button" class="close" data-dismiss="modal" aria-label="Close">
                    <span aria-hidden="true">&times;</span>
                </button>
            </div>
            <div class="modal-body">
                <p>Bạn có muốn xóa vĩnh viễn khóa học này không ?</p>
            </div>
            <div class="modal-footer">
                <button type="button" id="btn-delete-course" class="btn btn-danger">Xóa Bỏ</button>
                <button type="button" class="btn btn-secondary" data-dismiss="modal">Đóng</button>
            </div>
        </div>
    </div>
</div>

<form name="formDeleteHidden" method="POST"></form>
<form name="formRestoreHidden" method="POST"></form>

<script>
    // When Dom content load document.addEventListener('DOMContentLoaded',
    document.addEventListener('DOMContentLoaded', function () {
        let courseId;
        let deleteForm = document.forms['formDeleteHidden'];
        let restoreForm = document.forms['formRestoreHidden'];
        const buttonDelete = document.getElementById('btn-delete-course');
        const restoreBtn = $('.btn-restore');
        const checkboxAll = $('#checkbox-all');
        const courseItemCheckbox = $('input[name="courseIds"]');
        const checkAllSubmitBtn = $('.btn-check-all-submit-btn');

        $('#deleteModal').on('show.bs.modal', function (event) {
            const button = $(event.relatedTarget);
            courseId = button.data('id');

            console.log(courseId);
        });


        buttonDelete.onclick = function () {
            deleteForm.action = '/courses/' + courseId + '/force?_method=DELETE';
            deleteForm.submit();
        }

        // Restore Button Clicked
        restoreBtn.click(function (e) {
            e.preventDefault();
            const courseId = $(this).data('id');
            restoreForm.action = '/courses/' + courseId + '/restore?_method=PATCH';
            restoreForm.submit();
        });

        // Check if all data has been checked.
        checkboxAll.change(function () {
            let isCheckedAll = $(this).prop('checked');
            courseItemCheckbox.prop('checked', isCheckedAll);
            renderCheckAllSubmitBtn();
        });

        // Check item checkbox has been checked
        courseItemCheckbox.change(function () {
            const isCheckedAll = courseItemCheckbox.length === $('input[name="courseIds"]:checked').length;
            checkboxAll.prop('checked', isCheckedAll);
            renderCheckAllSubmitBtn();
        });

        function renderCheckAllSubmitBtn() {
            const checkedCount = $('input[name="courseIds"]:checked').length;
            if (checkedCount > 0) {
                checkAllSubmitBtn.attr('disabled', false);
            } else {
                checkAllSubmitBtn.attr('disabled', true);
            }
        }
    });
</script>