<h1>{{title}}</h1>

<div class="mt-4">
    <a href="/courses/create" class="btn btn-primary">Thêm mới</a>
    <div class="row">
        {{#each courses}}
            <div class="col-sm-6 col-lg-4">
                <div class="card mt-2">
                    <a href="/courses/{{this.slug}}">
                        <img
                            class="card-img-top"
                            src="{{this.thumbnail}}"
                            alt="{{this.name}}"
                        />
                    </a>
                    <div class="card-body">
                        <a href="/courses/{{this.slug}}">
                            <h5 class="card-title">
                                {{this.name}}
                            </h5>
                        </a>
                        <p class="card-text">
                            {{this.description}}
                        </p>
                    </div>
                </div>
            </div>
        {{/each}}
    </div>
</div>