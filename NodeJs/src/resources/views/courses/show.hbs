<div class="mt-4">
    <div class="row">
        <div class="col-lg-3">
            <button class="btn btn-primary">Học Ngay</button>
        </div>

        <div class="col-lg-9">
            <h2>{{course.name}}</h2>

            <iframe
                width="100%"
                height="500"
                src="https://www.youtube.com/embed/{{course.videoId}}"
                title="{{course.name}}"
                frameborder="0"
                allowfullscreen>
            </iframe>

            <p class="mt-3">
                {{course.description}}
            </p>
        </div>
    </div>
</div>