<div class="mt-4">
    <h3>Đăng khóa học</h3>

    <form method="POST" action="/courses/store">
        <div class="form-group">
            <label for="name">tên</label>
            <input
                type="text"
                name="name"
                class="form-control"
                placeholder="nhập tên"
                id="name"
            />
        </div>

        <div class="form-group">
            <label for="videoId">mã video</label>
            <input
                type="text"
                name="videoId"
                class="form-control"
                placeholder="nhập mã video"
                id="videoId"
            />
        </div>

        <div class="form-group">
            <label for="description">Mô tả khóa học</label>
            <textarea
                name="description"
                class="form-control"
                id="description"
                placeholder="Nhập mô tả"
            ></textarea>
        </div>
        <button type="submit" class="btn btn-primary">Thêm mới</button>
    </form>
</div>