    //         let course = await Course.findOne({slug: req.params.slug}).lean();
    //         res.render("courses/show", {
    //             course,
    //         });
    //     } catch (error) {
    //         res.json({ error: "Has error : " + error });
    //     }

    //     // res.render("courses/show");
    // }
}

module.exports = new CourseController();
